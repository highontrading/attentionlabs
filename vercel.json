{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/portfolio", "destination": "/work/", "permanent": true },
    { "source": "/casestudies", "destination": "/case-studies/", "permanent": true },
    { "source": "/methodology", "destination": "/services/", "permanent": true },
    { "source": "/intelligence/:path*", "destination": "/services/", "permanent": true }
  ]
}
